{
  "name": "files-viewer-web",
  "version": "1.0.0",
  "description": "Cliente web para el visor de archivos procesados",
  "private": true,
  "engines": {
    "node": ">=16 <17"
  },
  "scripts": {
    "start": "webpack serve --config webpack.config.js --env development",
    "dev": "npm run start",
    "build": "webpack --config webpack.config.js --env production",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "standard"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.2.7",
    "axios": "1.7.9",
    "bootstrap": "5.3.3",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-bootstrap": "2.10.5",
    "react-dom": "18.3.1",
    "react-redux": "9.1.2"
  },
  "devDependencies": {
    "@babel/core": "7.25.8",
    "@babel/preset-env": "7.25.8",
    "@babel/preset-react": "7.25.7",
    "@testing-library/dom": "9.3.4",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.5.2",
    "babel-loader": "9.2.1",
    "css-loader": "6.11.0",
    "html-webpack-plugin": "5.6.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "msw": "1.3.5",
    "standard": "17.1.2",
    "style-loader": "3.3.4",
    "webpack": "5.95.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "4.15.2"
  },
  "standard": {
    "env": [
      "jest"
    ],
    "globals": [
      "process"
    ]
  }
